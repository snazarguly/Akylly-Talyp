<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 and higher. -->
<data-extraction-rules>
    <!-- The user's Gemini API key must never leave the device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="akylly_talyp_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="akylly_talyp_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
